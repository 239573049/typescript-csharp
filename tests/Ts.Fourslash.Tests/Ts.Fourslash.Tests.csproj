<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ts</RootNamespace>
    <DefineConstants>$(DefineConstants);TS_FOURSLASH_RUNNER</DefineConstants>
    <!-- Generated fourslash corpus (phase 8); excluded from routine builds until populated. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ts.LanguageService/Ts.LanguageService.csproj" />
    <ProjectReference Include="../Ts.TestUtil/Ts.TestUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- global usings are per-compilation; share the generated AST alias set by
         linking the file (plan/04-codegen.md §2.2 #5). -->
    <Compile Include="../../src/Ts.Compiler/Ast/GlobalUsings.g.cs" Link="Ast/GlobalUsings.g.cs" />
    <!-- Ts.TestUtil intentionally does not depend on Ts.LanguageService. Compile the runner
         foundation into this LS-facing test assembly while keeping its source beside the parser. -->
    <Compile Include="../Ts.TestUtil/Fourslash/FourslashSession.cs" Link="Fourslash/FourslashSession.cs" />
  </ItemGroup>

</Project>
