<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ts</RootNamespace>
    <DefineConstants>$(DefineConstants);TS_FOURSLASH_RUNNER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The emitted corpus spells the Go package qualifiers `Core.X` / `Ls.X` (core.TSTrue,
         ls.SortText*) in every generated file. Go resolves those through the util.go
         dot-import plus the core/ls package names; C# has no ambient `Core`/`Ls` type, so the
         two qualifiers are declared compilation-wide here, under the alias names the generator
         emits (Core_/Ls_ — a plain `Core` alias cannot be declared at all: inside the util's
         own namespace the alias RHS binds to the namespace and yields CS0234, and a per-file
         alias for it collides with these global ones as CS1537).
         The `using static` supplies the util.go members the corpus names unqualified
         (AnyTextEdits, Ignored, DefaultCommitCharacters); it does not shadow the aliases. -->
    <Using Include="Ts.Fourslash.Tests.FourslashTestUtil" Static="true" />
    <Using Include="Ts.Fourslash.Tests.FourslashTestUtil" Alias="Core_" />
    <Using Include="Ts.Fourslash.Tests.FourslashTestUtil" Alias="Ls_" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Ts.Compiler's checker pool hashes with System.IO.Hashing.XxHash128; declare the
         runtime asset here so it always reaches the test output directory. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The linked GlobalUsings.g.cs aliases Ts.Ast/*, so Ts.Compiler must be visible to this
         compilation, not just transitively through Ts.LanguageService. -->
    <ProjectReference Include="../../src/Ts.Compiler/Ts.Compiler.csproj" />
    <ProjectReference Include="../../src/Ts.LanguageService/Ts.LanguageService.csproj" />
    <ProjectReference Include="../Ts.TestUtil/Ts.TestUtil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- global usings are per-compilation; share the generated AST alias set by
         linking the file (plan/04-codegen.md §2.2 #5). -->
    <Compile Include="../../src/Ts.Compiler/Ast/GlobalUsings.g.cs" Link="Ast/GlobalUsings.g.cs" />
    <!-- Ts.TestUtil intentionally does not depend on Ts.LanguageService. Compile the runner
         partials into this LS-facing test assembly while keeping their sources beside the
         parser (plan/08 §7.3; TS_FOURSLASH_RUNNER gates them out of Ts.TestUtil's own build). -->
    <Compile Include="../Ts.TestUtil/Fourslash/Fourslash.cs" Link="Fourslash/Fourslash.cs" />
    <Compile Include="../Ts.TestUtil/Fourslash/Fourslash.Verify.cs" Link="Fourslash/Fourslash.Verify.cs" />
    <Compile Include="../Ts.TestUtil/Fourslash/Fourslash.Baseline.cs" Link="Fourslash/Fourslash.Baseline.cs" />
    <Compile Include="../Ts.TestUtil/Fourslash/Fourslash.Options.cs" Link="Fourslash/Fourslash.Options.cs" />
    <Compile Include="../Ts.TestUtil/Fourslash/FourslashBaselineText.cs" Link="Fourslash/FourslashBaselineText.cs" />
    <Compile Include="../Ts.TestUtil/Fourslash/FourslashMarkers.cs" Link="Fourslash/FourslashMarkers.cs" />
    <!-- FourslashBaselineUtil.cs is deliberately NOT linked: it is unguarded and therefore
         already compiled into the referenced Ts.TestUtil assembly, and linking it here would
         surface CS0436 for every one of its types. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Port of internal/fourslash/_scripts/failingTests.txt (skip_if_failing.go). -->
    <EmbeddedResource Include="Scripts/failingTests.txt" />
    <!-- The C#-only failure list (plan/11 deviation D-021): not a tsgo file. Records the tests
         whose failure is a known gap in the C# port rather than in the ported test, so the suite
         can be green while the gap is tracked. -->
    <EmbeddedResource Include="Scripts/csharpFailingTests.txt" />
  </ItemGroup>

</Project>
