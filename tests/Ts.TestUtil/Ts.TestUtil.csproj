<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ts.TestUtil</RootNamespace>
    <!-- Shared harness library (port of internal/testutil): baseline diff+accept, fixture loaders. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ts.Compiler/Ts.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ports of Go package-private helpers (patience uniqueElements/makeHunks/typeSymbol,
         etc.) stay `internal`, mirroring Go visibility; the test assembly exercises them. -->
    <InternalsVisibleTo Include="Ts.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- global usings are per-compilation; share the generated AST alias set by
         linking the file (plan/04-codegen.md §2.2 #5). -->
    <Compile Include="../../src/Ts.Compiler/Ast/GlobalUsings.g.cs" Link="Ast/GlobalUsings.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assert.SkipUnless etc. for harness helpers (RepoPaths.SkipIfNoTypeScriptSubmodule).
         Library projects must use the assert package, not the executable test metapackage. -->
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

</Project>
