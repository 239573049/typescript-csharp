<Project>
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <!-- xUnit projects run on the JIT; the shared Ts.TestUtil project remains a
       normal class library. Phase gates additionally re-run the conformance
       suite against the published AOT binary. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
</Project>
