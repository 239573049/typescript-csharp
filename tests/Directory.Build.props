<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- xUnit projects run on the JIT; the shared Ts.TestUtil project remains a
       normal class library. Phase gates additionally re-run the conformance
       suite against the published AOT binary. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

</Project>
