# Source/configuration files use deterministic LF line endings.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf

# testdata is a byte-for-byte mirror of the pinned tsgo Git tree. Some upstream
# baselines intentionally contain CRLF, so Git must never normalize this tree.
testdata/** -text

# Differential-fixture shards use Git LFS (fixtures/README.md, G0.5).
fixtures/*.tar.zst filter=lfs diff=lfs merge=lfs -text
