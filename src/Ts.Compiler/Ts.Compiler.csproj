<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ts</RootNamespace>
    <Description>TypeScript compiler core (1:1 port of typescript-go internal packages: core…transformers)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Go tests live inside the package and exercise unexported functions
         (e.g. tspath.reducePathComponents). Ported tests keep that access via
         internal + InternalsVisibleTo (05-conventions.md §16). -->
    <InternalsVisibleTo Include="Ts.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-flight ahead-of-order port: Tracing.cs references Ts.Ast.Node/Symbol,
         which land in phase 3/4. Excluded so the tree stays green (AGENTS.md §4-10);
         remove this line when the Ast types exist and Tracing compiles. -->
    <Compile Remove="Tracing/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 07-aot-constraints.md §5.2: explicit, stable logical names. Runtime reads
         via Assembly.GetManifestResourceStream("bundled/libs/<name>"); lib
         discovery goes through the generated Bundled.LibNames, never through
         GetManifestResourceNames scanning. Bundled/libs/ is entirely a generated
         product of tools/generator/generate-libs.ts (plan/04-codegen.md §4). -->
    <EmbeddedResource Include="Bundled/libs/**/*.d.ts"
                      LogicalName="bundled/libs/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Compiler recursion must never escape to the default thread pool: its workers
    have an approximately 1 MB stack. Keep these restrictions project-local so
    Ts.LanguageService may still use Task.Run at a pure IO/scheduling boundary.
    The Banned API analyzer officially consumes BannedSymbols.*.txt files.
  -->
  <ItemGroup>
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run(System.Action)" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run(System.Action,System.Threading.CancellationToken)" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run(System.Func{System.Threading.Tasks.Task})" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run(System.Func{System.Threading.Tasks.Task},System.Threading.CancellationToken)" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run``1(System.Func{System.Threading.Tasks.Task{``0}})" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run``1(System.Func{System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run``1(System.Func{``0})" />
    <_CompilerBannedSymbol Include="M:System.Threading.Tasks.Task.Run``1(System.Func{``0},System.Threading.CancellationToken)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.QueueUserWorkItem(System.Threading.WaitCallback)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.QueueUserWorkItem(System.Threading.WaitCallback,System.Object)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.QueueUserWorkItem``1(System.Action{``0},``0,System.Boolean)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.UnsafeQueueUserWorkItem(System.Threading.IThreadPoolWorkItem,System.Boolean)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.UnsafeQueueUserWorkItem(System.Threading.WaitCallback,System.Object)" />
    <_CompilerBannedSymbol Include="M:System.Threading.ThreadPool.UnsafeQueueUserWorkItem``1(System.Action{``0},``0,System.Boolean)" />
  </ItemGroup>

  <Target Name="GenerateCompilerBannedSymbols" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- IntermediateOutputPath is finalized only after project evaluation. -->
      <CompilerBannedSymbolsFile>$(IntermediateOutputPath)BannedSymbols.Compiler.txt</CompilerBannedSymbolsFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
      File="$(CompilerBannedSymbolsFile)"
      Lines="@(_CompilerBannedSymbol)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <AdditionalFiles Include="$(CompilerBannedSymbolsFile)" />
    </ItemGroup>
  </Target>

</Project>
