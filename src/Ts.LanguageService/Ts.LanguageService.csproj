<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ts</RootNamespace>
    <Description>TypeScript language service, LSP server, project system, and API layer (port of typescript-go ls/lsp/project/api/format/fswatch/jsonrpc)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ts.Compiler/Ts.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test seam: format rule engine internals are exercised by the test project
         (plan/05-conventions.md §16, same pattern as Ts.Compiler). -->
    <InternalsVisibleTo Include="Ts.LanguageService.Tests" />
    <!-- Test seam: the fourslash runner drives the LSP-shaped LS entries directly instead of
         over the JSON-RPC wire (plan/08 §7.3, D-012): ProvideReferences (:694),
         ProvideVSReferences (:708), ProvideImplementations (:925) and ResolveCodeLens are
         internal, and their Go counterparts are exported. -->
    <InternalsVisibleTo Include="Ts.Fourslash.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- global usings are per-compilation; share the generated AST alias set by
         linking the file (plan/04-codegen.md §2.2 #5). -->
    <Compile Include="../Ts.Compiler/Ast/GlobalUsings.g.cs" Link="Ast/GlobalUsings.g.cs" />
  </ItemGroup>

</Project>
